+static QString mcpBridgeUrl()
+{
+    QString url = qEnvironmentVariable("KDENLIVE_MCP_BRIDGE");
+    if (url.isEmpty()) {
+        url = QStringLiteral("http://127.0.0.1:7801");
+    }
+    while (url.endsWith(QLatin1Char('/'))) {
+        url.chop(1);
+    }
+    return url;
+}
+
+static QJsonArray mcpFetchJobs(QString *errorOut)
+{
+    QNetworkAccessManager manager;
+    QNetworkRequest request(QUrl(mcpBridgeUrl() + QStringLiteral("/jobs")));
+    request.setTransferTimeout(3000);
+    QNetworkReply *reply = manager.get(request);
+    QEventLoop loop;
+    QObject::connect(reply, &QNetworkReply::finished, &loop, &QEventLoop::quit);
+    loop.exec();
+    if (reply->error() != QNetworkReply::NoError) {
+        if (errorOut) {
+            *errorOut = reply->errorString();
+        }
+        reply->deleteLater();
+        return {};
+    }
+    const QJsonDocument doc = QJsonDocument::fromJson(reply->readAll());
+    reply->deleteLater();
+    return doc.isArray() ? doc.array() : doc.object().value(QStringLiteral("jobs")).toArray();
+}
+
+static bool mcpPostJson(const QString &path, const QJsonObject &payload, QString *errorOut)
+{
+    QNetworkAccessManager manager;
+    QNetworkRequest request(QUrl(mcpBridgeUrl() + path));
+    request.setHeader(QNetworkRequest::ContentTypeHeader, QStringLiteral("application/json"));
+    request.setTransferTimeout(3000);
+    QNetworkReply *reply = manager.post(request, QJsonDocument(payload).toJson(QJsonDocument::Compact));
+    QEventLoop loop;
+    QObject::connect(reply, &QNetworkReply::finished, &loop, &QEventLoop::quit);
+    loop.exec();
+    const bool ok = reply->error() == QNetworkReply::NoError;
+    if (!ok && errorOut) {
+        *errorOut = reply->errorString();
+    }
+    reply->deleteLater();
+    return ok;
+}
+
+void MainWindow::slotMcpImportRender()
+{
+    QString fetchError;
+    const QJsonArray jobs = mcpFetchJobs(&fetchError);
+    if (!fetchError.isEmpty()) {
+        KMessageBox::error(this, i18n("Could not reach the kdenlive-mcp bridge at %1.\n\n%2", mcpBridgeUrl(), fetchError));
+        return;
+    }
+    const QList<QJsonObject> candidates = mcpFinishedJobs(jobs);
+    if (candidates.isEmpty()) {
+        KMessageBox::information(this, i18n("The bridge has no finished render jobs."));
+        return;
+    }
+    QStringList labels;
+    for (const QJsonObject &job : candidates) {
+        labels << QStringLiteral("%1 — %2").arg(job.value(QStringLiteral("job_id")).toString(),
+                                                QFileInfo(job.value(QStringLiteral("output")).toString()).fileName());
+    }
+    bool ok = false;
+    const QString choice = QInputDialog::getItem(this, i18n("Import MCP Render"), i18n("Render job:"), labels, 0, false, &ok);
+    if (!ok || choice.isEmpty()) {
+        return;
+    }
+    QString message;
+    if (mcpImportJobOutput(candidates.at(labels.indexOf(choice)), &message).isEmpty()) {
+        KMessageBox::error(this, message);
+    }
+}
+
+QList<QJsonObject> MainWindow::mcpFinishedJobs(const QJsonArray &jobs)
+{
+    QList<QJsonObject> candidates;
+    for (const QJsonValue &value : jobs) {
+        const QJsonObject job = value.toObject();
+        if (job.value(QStringLiteral("status")).toString() == QLatin1String("finished")) {
+            candidates << job;
+        }
+    }
+    return candidates;
+}
+
+QString MainWindow::mcpImportJobOutput(const QJsonObject &job, QString *message)
+{
+    const QString output = job.value(QStringLiteral("output")).toString();
+    if (!QFileInfo::exists(output)) {
+        if (message) {
+            *message = i18n("The rendered file does not exist:\n%1", output);
+        }
+        return {};
+    }
+    const QString binId = pCore->bin()->slotAddClipToProject(QUrl::fromLocalFile(output));
+    if (!binId.isEmpty()) {
+        statusBar()->showMessage(i18n("Imported %1 from kdenlive-mcp", QFileInfo(output).fileName()), 5000);
+    } else if (message) {
+        *message = i18n("Could not add %1 to the project bin.", QFileInfo(output).fileName());
+    }
+    return binId;
+}
+
+void MainWindow::slotMcpSendSelection()
+{
+    QJsonObject payload;
+    QString message;
+    if (!mcpBuildSelectionPayload(&payload, &message)) {
+        KMessageBox::information(this, message);
+        return;
+    }
+
+    QString postError;
+    if (!mcpPostJson(QStringLiteral("/selection"), payload, &postError)) {
+        KMessageBox::error(this, i18n("Could not send the selection to %1.\n\n%2", mcpBridgeUrl(), postError));
+        return;
+    }
+    statusBar()->showMessage(i18n("Sent %1 clip(s) to kdenlive-mcp", payload.value(QStringLiteral("clips")).toArray().size()), 5000);
+}
+
+bool MainWindow::mcpBuildSelectionPayload(QJsonObject *payload, QString *message)
+{
+    TimelineWidget *timeline = getCurrentTimeline();
+    const QList<int> ids = timeline ? timeline->controller()->selection() : QList<int>();
+    if (ids.isEmpty()) {
+        if (message) {
+            *message = i18n("Select at least one clip in the timeline first.");
+        }
+        return false;
+    }
+    QJsonArray clips;
+    for (int id : ids) {
+        const QString binId = timeline->controller()->getClipBinId(id);
+        if (binId.isEmpty()) {
+            continue;
+        }
+        std::shared_ptr<ProjectClip> clip = pCore->bin()->getBinClip(binId);
+        if (!clip) {
+            continue;
+        }
+        QJsonObject item;
+        item.insert(QStringLiteral("timeline_clip_id"), id);
+        item.insert(QStringLiteral("bin_id"), binId);
+        item.insert(QStringLiteral("name"), clip->clipName());
+        item.insert(QStringLiteral("url"), clip->clipUrl());
+        clips.append(item);
+    }
+    payload->insert(QStringLiteral("timeline_id"), pCore->currentTimelineId().toString());
+    payload->insert(QStringLiteral("clips"), clips);
+    return true;
+}
+
+void MainWindow::mcpSelftestProjectTick()
+{
+    // Waits (1 s per tick) for the command line project, then exercises the same
+    // code the two slots use: import a finished render into the bin, select the
+    // timeline clips, build the payload and post it.
+    ++mcpSelftestProjectAttempts;
+    QMenu *projectMenu = static_cast<QMenu *>(factory()->container(QStringLiteral("go"), this));
+    QStringList names;
+    if (projectMenu) {
+        for (QAction *entry : projectMenu->actions()) {
+            names << (entry->isSeparator() ? QStringLiteral("---") : entry->text());
+        }
+    }
+    TimelineWidget *timeline = getCurrentTimeline();
+    if (timeline) {
+        timeline->controller()->selectAll();
+    }
+    const QList<int> selection = timeline ? timeline->controller()->selection() : QList<int>();
+    if (selection.isEmpty() && mcpSelftestProjectAttempts < 15) {
+        return;
+    }
+    // Timeline ready (or timeout): run both paths once.
+    QString fetchError;
+    const QJsonArray jobs = mcpFetchJobs(&fetchError);
+    QString importedId;
+    const QList<QJsonObject> candidates = mcpFinishedJobs(jobs);
+    if (!candidates.isEmpty()) {
+        QString message;
+        importedId = mcpImportJobOutput(candidates.first(), &message);
+        if (importedId.isEmpty()) {
+            fetchError = message;
+        }
+    }
+    QJsonObject payload;
+    QString buildMessage;
+    const bool built = mcpBuildSelectionPayload(&payload, &buildMessage);
+    QString postError;
+    bool posted = false;
+    if (built) {
+        posted = mcpPostJson(QStringLiteral("/selection"), payload, &postError);
+    }
+    fprintf(stderr, "MCP_SELFTEST_ACTIONS: %s\n", qPrintable(names.join(QStringLiteral(" | "))));
+    fprintf(stderr, "MCP_SELFTEST_PROJECT: attempts=%d clips=%d imported=%s built=%d posted=%d error=%s\n",
+            mcpSelftestProjectAttempts, int(payload.value(QStringLiteral("clips")).toArray().size()),
+            qPrintable(importedId), built ? 1 : 0, posted ? 1 : 0,
+            qPrintable(postError.isEmpty() ? (fetchError.isEmpty() ? buildMessage : fetchError) : postError));
+    fflush(stderr);
+    std::_Exit(built && posted ? 0 : 1);
+}
